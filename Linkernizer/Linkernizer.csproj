<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <PackageId>Linkernizer</PackageId>
    <Title>Linkernizer</Title>
    <Description>The (possibly best) .NET library for automatically linking URLs and email addresses</Description>
    <PackageTags>autolink;linkify;linkification;links;url;email;hyperlink;anchor;html;markup</PackageTags>
    <AssemblyVersion>1.4.0</AssemblyVersion>
    <Version>1.4.0</Version>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.301" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Linkernizer.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\images\icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
